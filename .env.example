ENTREZ_EMAIL=
ENTREZ_API_KEY=

# LLM used for synonym enrichment: provider:model
#   anthropic:claude-sonnet-5-5   (needs ANTHROPIC_API_KEY; a claude.ai Max plan does not cover API calls)
#   groq:llama-3.3-70b-versatile  (needs GROQ_API_KEY; free tier available)
#   openrouter:<vendor/model>     (needs OPENROUTER_API_KEY)
#   ollama:<model>                (local, no key)
LLM_MODEL=groq:llama-3.3-70b-versatile
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Legacy (still read if LLM_MODEL is unset): GROQ_MODEL=llama-3.3-70b-versatile

# Don't leave any spaces. It might not retrieve your information correctly.
