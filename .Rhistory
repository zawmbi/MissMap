title = "Total synonyms per species (AI-enriched MissMap)",
x = "Species",
y = "Number of synonyms"
) +
theme_minimal(base_size = 14) +
theme(
axis.text.y = element_text(face = "italic"),
legend.position = "none",
plot.title = element_text(hjust = 0.5)
)
