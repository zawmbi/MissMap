knitr::opts_chunk$set(echo = TRUE)
library(leaps) # adjusted R^2 package
set.seed(2024)
predictor_X <- rnorm(n = 100)
noise_vector_epsilon <- rnorm(n = 100)
Beta_0 <- 1
Beta_1 <- 3
Beta_2 <- 2
Beta_3 <- -1
response_Y <- Beta_0 +
Beta_1 * predictor_X +
Beta_2 * predictor_X^2 +
Beta_3 * predictor_X^4 + # PREDICTOR x IS 4 HERE !
noise_vector_epsilon
df <- data.frame(Y = response_Y, X = predictor_X)
best_subset_selection <- regsubsets(response_Y~., poly(predictor_X, 10), nvmax = 10) # ?regsubsets
best_subset_summary <- summary(best_subset_selection)
best_cp   <- which.min(best_subset_summary$cp) # want lowest value
best_bic  <- which.min(best_subset_summary$bic) # want lowest value
best_adjr <- which.max(best_subset_summary$adjr2) # want highest value
best_cp # 6 vars
best_bic # 5 vars
best_adjr # 9 vars
par(mfrow=c(2,2))
plot(best_subset_summary$rsq, main = "R^2", xlab = "Size", ylab = "R^2", type = "b")
plot(best_subset_summary$bic, main = "BIC", xlab = "Size", ylab = "BIC", type = "b")
plot(best_subset_summary$cp, main = "C_p", xlab = "Size", ylab = "C_p", type = "b")
plot(best_subset_summary$adjr2,  main = "Adjusted R^2",
xlab = "Size", ylab = "Adjusted R^2", type = "b") # lined points
par(mfrow=c(1,1))
coef_cp <- coef(best_subset_selection, best_cp) # best Cp coefficient
coef_cp
coef_bic <- coef(best_subset_selection, best_bic) # best BIC coefficient
coef_bic
coef_adjr <- coef(best_subset_selection, best_adjr) # best R^2 coefficient
coef_adjr
# forward selection
forward_selection <- regsubsets(response_Y ~ ., poly(predictor_X, 10), nvmax = 10, method = "forward")
forward.summary <- summary(forward_selection)
best_cp_forward   <- which.min(forward.summary$cp)
best_bic_forward  <- which.min(forward.summary$bic)
best_adjr_forward <- which.max(forward.summary$adjr2)
best_cp_forward   # 6
best_bic_forward  # 5
best_adjr_forward # 9
par(mfrow = c(2, 2))
plot(forward.summary$rsq, main = "R^2 (Forward)", xlab = "Size", ylab = "R^2", type = "b") # lined points
plot(forward.summary$bic, main = "BIC (Forward)", xlab = "Size", ylab = "BIC", type = "b")
plot(forward.summary$cp, main = "C_p (Forward)", xlab = "Size", ylab = "C_p", type = "b")
plot(forward.summary$adjr2,  main = "Adjusted R^2 (Forward)", xlab = "Size", ylab = "Adj R^2", type = "b")
par(mfrow = c(1, 1))
coef_cp_forward   <- coef(forward_selection, best_cp_forward)
coef_bic_forward  <- coef(forward_selection, best_bic_forward)
coef_adjr_forward <- coef(forward_selection, best_adjr_forward)
coef_cp_forward
coef_bic_forward
coef_adjr_forward
# backwards selection
backward_selection <- regsubsets(response_Y ~ ., poly(predictor_X, 10), nvmax = 10, method = "backward")
backward.summary <- summary(backward_selection)
best_cp_backward   <- which.min(backward.summary$cp)
best_bic_backward  <- which.min(backward.summary$bic)
best_adjr_backward <- which.max(backward.summary$adjr2)
best_cp_backward   # 6
best_bic_backward  # 5
best_adjr_backward # 9
par(mfrow = c(2, 2))
plot(backward.summary$rsq, main = "R^2 (Backward)", xlab = "Size", ylab = "R^2", type = "b")
plot(backward.summary$bic, main = "BIC (Backward)", xlab = "Size", ylab = "BIC", type = "b")
plot(backward.summary$cp, main = "C_p (Backward)", xlab = "Size", ylab = "C_p", type = "b")
plot(backward.summary$adjr2, main = "Adjusted R^2 (Backward)", xlab = "Size", ylab = "Adj R^2", type = "b")
par(mfrow = c(1, 1))
coef_cp_backward   <- coef(backward_selection, best_cp_backward) # best Cp coefficient
coef_bic_backward  <- coef(backward_selection, best_bic_backward) # best BIC coefficient
coef_adjr_backward <- coef(backward_selection, best_adjr_backward) # best adjusted R^2 coefficient
coef_cp_backward
coef_bic_backward
coef_adjr_backward
library(glmnet)
poly_matrix <- model.matrix(Y ~ poly(X, 10, raw = TRUE), data = df)[, -1]
glm_results <- cv.glmnet(poly_matrix, response_Y, alpha = 1)
plot(glm_results)
best_lambda <- glm_results$lambda.min
lasso_model = glmnet(poly_matrix, response_Y, alpha = 1, lambda = best_lambda)
coef(lasso_model)
cat("Best lambda = ", best_lambda, "\n")
Beta_0 <- 1
Beta_5 <- 1
response_Y2 <- Beta_0 + Beta_5 * predictor_X^5 + noise_vector_epsilon
df2 <- data.frame(Y = response_Y2, X = predictor_X)
# Best Subset Selection
best_subset_selection2 <- regsubsets(Y ~ poly(X, 10, raw = TRUE), data = df2, nvmax = 10)
best_subset_summary2 <- summary(best_subset_selection2)
best_cp2   <- which.min(best_subset_summary2$cp)
best_bic2  <- which.min(best_subset_summary2$bic)
best_adjr2 <- which.max(best_subset_summary2$adjr2)
best_cp2    # optimal subset size according to Cp
best_bic2   # optimal subset size according to BIC
best_adjr2  # optimal subset size according to Adjusted R^2
par(mfrow=c(2,2))
plot(best_subset_summary2$rsq, main = "R^2", xlab = "Size", ylab = "R^2", type = "b")
plot(best_subset_summary2$bic, main = "BIC", xlab = "Size", ylab = "BIC", type = "b")
plot(best_subset_summary2$cp, main = "C_p", xlab = "Size", ylab = "C_p", type = "b")
plot(best_subset_summary2$adjr2, main = "Adjusted R^2", xlab = "Size", ylab = "Adj R^2", type = "b")
par(mfrow=c(1,1))
coef(best_subset_selection2, best_cp2)
coef(best_subset_selection2, best_bic2)
coef(best_subset_selection2, best_adjr2)
# Lasso regression
poly_matrix2 <- model.matrix(Y ~ poly(X, 10, raw = TRUE), data = df2)[, -1]
lasso_cv <- cv.glmnet(poly_matrix2, response_Y2, alpha = 1)
plot(lasso_cv)
best_lambda2 <- lasso_cv$lambda.min
cat("Best lambda = ", best_lambda2, "\n")
lasso_model2 <- glmnet(poly_matrix2, response_Y2, alpha = 1, lambda = best_lambda2)
coef(lasso_model2)
