library(ISLR)
data(College)
train <- College[sample(1:nrow(College), nrow(College)/2), ]
test <- College[!(rownames(College) %in% rownames(train)), ]
lm <- lm(Apps ~ ., data = train)
lm_prediction <- predict(lm, test)
lm_test_error <- mean((test$Apps - lm_prediction)^2)
lm_test_error # 1253307
x_train <- model.matrix(Apps ~ ., data = train)[, -1]
x_test <- model.matrix(Apps ~ ., data = test)[, -1]
ridge_model <- cv.glmnet(x_train, train$Apps, alpha = 0)
best_lambda_ridge <- ridge_model$lambda.min
ridge_prediction <- predict(ridge_model, s = best_lambda_ridge, newx = x_test)
ridge_test_error <- mean((test$Apps - ridge_prediction)^2)
ridge_test_error # 2007560
lasso_regression <- cv.glmnet(x_train, train$Apps, alpha = 1)
best_lambda_lasso <- lasso_regression$lambda.min
lasso_prediction <- predict(lasso_regression, s = best_lambda_lasso, newx = x_test)
lasso_test_error <- mean((test$Apps - lasso_prediction)^2)
lasso_coef <- coef(lasso_regression,s = best_lambda_lasso)
num_non_zero_coef <- length(lasso_coef[lasso_coef != 0]) - 1
lasso_test_error # 1280906
num_non_zero_coef # 15
library(pls)
model_pcr <- pcr(Apps ~ ., data = train, scale = TRUE, validation = "CV")
summary(model_pcr)
# cv plot
validationplot(model_pcr)
best_M_PCR <- which.min(MSEP(model_pcr)$val[1, , ]) - 1
pcr_prediction <- predict(model_pcr, newdata = test, ncomp = best_M_PCR)
pcr_test_error <- mean((test$Apps - pcr_prediction)^2)
pcr_test_error # 1253307
best_M_PCR #  17
plsr_model <- plsr(Apps ~ ., data = train, scale = TRUE, validation = "CV")
summary(plsr_model)
validationplot(plsr_model)
validationplot(plsr_model, val.type="MSEP")
validationplot(plsr_model, val.type="R2")
plsr_best_M <- which.min(MSEP(plsr_model)$val[1, , ] - 1)
plsr_prediction <- predict(plsr_model, test, ncomp = plsr_best_M)
plsr_test_error <- mean((test$Apps - plsr_prediction)^2)
plsr_test_error # 1262493
plsr_best_M # 11
errors <- c(lm_test_error, ridge_test_error, lasso_test_error, pcr_test_error, plsr_test_error)
names(errors) <- c("LM", "Ridge", "Lasso", "PCR", "PLSR")
print(sort(errors))
