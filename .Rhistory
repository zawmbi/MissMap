summary(model_pcr)
# cv plot
validationplot(model_pcr)
best_M_PCR <- which.min(MSEP(model_pcr)$val[1, , ]) - 1
pcr_prediction <- predict(model_pcr, newdata = test, ncomp = best_M_PCR)
pcr_test_error <- mean((test$Apps - pcr_prediction)^2)
pcr_test_error # 1253307
best_M_PCR #  17
plsr_model <- plsr(Apps ~ ., data = train, scale = TRUE, validation = "CV")
summary(plsr_model)
validationplot(plsr_model)
validationplot(plsr_model, val.type="MSEP")
validationplot(plsr_model, val.type="R2")
plsr_best_M <- which.min(MSEP(plsr_model)$val[1, , ] - 1)
plsr_prediction <- predict(plsr_model, test, ncomp = plsr_best_M)
plsr_test_error <- mean((test$Apps - plsr_prediction)^2)
plsr_test_error # 1262493
plsr_best_M # 11
errors <- c(lm_test_error, ridge_test_error, lasso_test_error, pcr_test_error, plsr_test_error)
names(errors) <- c("LM", "Ridge", "Lasso", "PCR", "PLSR")
print(sort(errors))
