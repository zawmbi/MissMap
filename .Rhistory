df <- read_csv("data_availability_matrix_20251119-010052.csv")
# Handle missing synonyms safely
df_syn <- df %>%
mutate(
synonyms = if_else(is.na(synonyms), "", synonyms),
SynonymCount = if_else(
str_trim(synonyms) == "",
0L,
lengths(strsplit(synonyms, ","))
)
)
# Simple barplot: how many names MissMap can use per species
ggplot(df_syn, aes(x = reorder(Species, SynonymCount), y = SynonymCount)) +
geom_col() +
coord_flip() +
labs(
title = "Number of synonyms MissMap can search with (per species)",
x = "Species",
y = "Synonym count"
) +
theme_minimal(base_size = 14)
